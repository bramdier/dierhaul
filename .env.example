# DHL Shipment Tracking – Unified (Europe: https://api-eu.dhl.com)
# Copy to .env.local for local dev only — do NOT commit real keys.
#
# Production: set these in your host (Vercel, Railway, etc.). Never use NEXT_PUBLIC_
# for API keys or secrets (those would be exposed in the browser bundle).

DHL_API_KEY=
DHL_API_SECRET=
DHL_TRACKING_BASE_URL=https://api-eu.dhl.com

# Neon Postgres — get this from https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Admin credentials — used to protect /admin/* routes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-32-byte-hex-secret
